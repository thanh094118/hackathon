ALERTS_ENABLED=0
ALERT_DRY_RUN=1
ALERT_CHANNELS=email,telegram,slack
ALERT_DASHBOARD_URL=http://localhost:8501

ALERT_EMAIL_ENABLED=0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=alerts@example.com
SMTP_TO=security@example.com
SMTP_USE_TLS=1

ALERT_TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=<telegram-chat-id>

ALERT_SLACK_ENABLED=0
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<placeholder>
