# MongoDB Configuration
MONGODB_URI=mongodb+srv://A:a@cluster0.ucebsox.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=security_logs
MONGODB_COLLECTION_NAME=unified_logs

# Other configurations
DEFAULT_RULES_PATH=data/labels/attack_patterns.yaml

ALERTS_ENABLED=1
ALERT_DRY_RUN=0
ALERT_CHANNELS=email

ALERT_EMAIL_ENABLED=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TO=security@example.com
SMTP_USE_TLS=1

ALERT_TELEGRAM_ENABLED=1
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

ALERT_SLACK_ENABLED=1
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz